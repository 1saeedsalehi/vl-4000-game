<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Videoland4000.BlazorUI</RootNamespace>
    <AssemblyName>Videoland4000.BlazorUI</AssemblyName>
    <PublishTrimmed>false</PublishTrimmed>
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <!-- Every runtime file gets a content hash in its name (index.html uses the #[.{fingerprint}] placeholders),
         so a CDN edge cache can never serve an old runtime file next to a new one after a deployment. -->
    <WasmFingerprintDotnetJs>true</WasmFingerprintDotnetJs>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>
</Project>
